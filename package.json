{
  "name": "@peri-code/agent-network",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WeBots: Bun-hosted MCP 2026-07-28 service with MCPP Files v1 drive",
  "scripts": {
    "dev": "bun --watch src/bun/main.ts",
    "start": "bun src/bun/main.ts",
    "build:client": "bun scripts/build-client.ts",
    "build:web": "vite build",
    "dev:web": "vite",
    "preview:web": "vite preview",
    "test:e2e": "playwright test",
    "test:spa-shell": "bun run build:web && bun scripts/verify-spa-shell.ts",
    "test:schema-parity": "bun scripts/verify-drizzle-schema.ts",
    "test:drizzle": "bun scripts/verify-drizzle-runtime.ts",
    "test:mcp-parity": "bun scripts/verify-mcp-parity.ts",
    "capture:mcp-baseline": "bun scripts/capture-mcp-baseline.ts",
    "q01-upgrade-check": "bun scripts/q01-upgrade-check.ts",
    "typecheck": "tsrs --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "test:units": "bun scripts/verify-refactor-units.ts",
    "test:protocol": "bun scripts/verify-protocol.ts",
    "test:acceptance": "bun scripts/acceptance.ts",
    "test:client-contract": "bun scripts/verify-client-contract.ts",
    "test:memory-contracts": "bun scripts/verify-memory-contracts.ts",
    "test:client": "bun scripts/verify-client-cli.ts",
    "test:drive": "bun scripts/verify-drive.ts",
    "test:m07": "bun scripts/verify-m07.ts",
    "test:events": "bun scripts/verify-events.ts",
    "test:ts-monitor": "bun scripts/verify-ts-monitor.ts",
    "test:dsh-plugin": "bun scripts/verify-dsh-plugin.ts",
    "test:ts-codex-monitor": "bun scripts/verify-ts-codex-monitor.ts",
    "test:web": "bun scripts/verify-web.ts",
    "test:web:contacts": "bun scripts/verify-contact-search-web.ts",
    "test:architecture": "bun scripts/verify-architecture-hotpaths.ts",
    "test:hotpaths": "bun scripts/verify-hotpaths.ts",
    "test:ux": "bun scripts/ux-luna/run.ts",
    "test:web:perf": "bun scripts/verify-web-perf.ts",
    "test:perf": "PERF_EXPECT_INDEX=1 bun scripts/verify-perf.ts",
    "db:migrate": "bun src/bun/migrate.ts",
    "test:memory-access": "bun scripts/verify-memory-access.ts",
    "test:memory-intake": "bun scripts/verify-memory-intake.ts",
    "test:memory-ledger": "bun scripts/verify-memory-ledger.ts && bun scripts/verify-memory-recovery.ts && bun scripts/verify-memory-intake.ts",
    "test:memory-experience": "bun scripts/verify-memory-experience.ts && bun scripts/verify-memory-coverage.ts && bun scripts/verify-memory-catchup.ts",
    "test:memory-hindsight": "bun scripts/verify-memory-hindsight.ts",
    "test:memory-langfuse": "bun scripts/verify-memory-langfuse.ts",
    "test:memory-recovery": "bun scripts/verify-memory-recovery.ts",
    "test:memory-host": "bun scripts/verify-memory-host.ts",
    "test:memory-integration": "bun scripts/verify-memory-integration.ts",
    "test:web:a11y": "bun scripts/verify-web-a11y.ts"
  },
  "dependencies": {
    "@isaacs/ttlcache": "^2.1.5",
    "@modelcontextprotocol/server": "2.3.1",
    "@peri-code/mcpp": "0.9.0",
    "@use-gesture/react": "^10.3.1",
    "commander": "^15.1.0",
    "drizzle-orm": "0.45.4",
    "eventsource-parser": "^3.1.1",
    "fabric": "^6.7.0",
    "flydrive": "2.2.0",
    "hono": "^4.13.13",
    "kubai-icons": "^0.3.1",
    "mcp-use": "2.12.4",
    "p-limit": "^7.3.3",
    "proper-lockfile": "4.1.2",
    "react": "19",
    "react-dom": "19",
    "rehype-harden": "^1.1.8",
    "remark-breaks": "^4.0.0",
    "remend": "1.4.0",
    "streamdown": "2.7.0",
    "write-file-atomic": "^7.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "1.64.1",
    "@types/bun": "^1.4.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "drizzle-kit": "0.31.11",
    "playwright": "^1.64.1",
    "tsrs": "0.21.0-ts7.1.0-beta",
    "typescript": "^7.0.2",
    "vite": "7.3.8"
  }
}
